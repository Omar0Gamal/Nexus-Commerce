{
  "uid": "infra-overview",
  "title": "Infrastructure",
  "tags": ["infra", "nexus"],
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "pgxpool Acquired Connections",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "backend_pgxpool_acquired_conns",
          "legendFormat": "acquired"
        },
        {
          "datasource": "Prometheus",
          "expr": "backend_pgxpool_idle_conns",
          "legendFormat": "idle"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "value": null, "color": "green" },
              { "value": 70, "color": "yellow" },
              { "value": 90, "color": "red" }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Redis Memory (bytes)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "redis_memory_used_bytes",
          "legendFormat": "used"
        },
        {
          "datasource": "Prometheus",
          "expr": "redis_memory_max_bytes",
          "legendFormat": "max"
        }
      ]
    },
    {
      "id": 3,
      "title": "Gateway Total Requests",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "sum(rate(gateway_requests_total[1m]))",
        "legendFormat": "req/s"
      }]
    },
    {
      "id": 4,
      "title": "Backend Total Requests",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "sum(rate(backend_requests_total[1m]))",
        "legendFormat": "req/s"
      }]
    }
  ]
}
